# Autokong credentials — copy to `.env` and fill in your own values.
# `.env` is git-ignored: never commit real credentials to the repository.

# --- Notifications (optional) ------------------------------------------------
# Each channel is skipped entirely when its variables are left empty.

# Discord: Server Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK=

# Pushover: https://pushover.net (user key + application API token)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# --- Plex --------------------------------------------------------------------
# These can also be set from the WebUI (stored in settings.db), which takes
# precedence over the values below.
PLEX_HOST=http://localhost:32400
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

# --- Email report (optional) -------------------------------------------------
SEND_EMAIL_REPORT=false
EMAIL_SENDER=
EMAIL_RECIPIENT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
